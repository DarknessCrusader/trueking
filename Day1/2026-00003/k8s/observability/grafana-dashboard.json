{
  "dashboard": {
    "title": "wsc2026-grafana-dashboard",
    "uid": "wsc2026-main",
    "templating": {
      "list": [
        {"name": "nodegroup", "type": "query", "datasource": "prometheus", "query": "label_values(kube_node_labels, label_eks_amazonaws_com_nodegroup)", "refresh": 2, "multi": true, "includeAll": true},
        {"name": "namespace", "type": "query", "datasource": "prometheus", "query": "label_values(kube_pod_info, namespace)", "refresh": 2, "multi": true, "includeAll": true}
      ]
    },
    "panels": [
      {"title": "Node", "type": "row", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "collapsed": false},
      {
        "title": "Node CPU (%)", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 1}, "datasource": "prometheus",
        "targets": [{"expr": "(1 - avg by (node) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))) * 100 * on(node) group_left(label_eks_amazonaws_com_nodegroup) kube_node_labels{label_eks_amazonaws_com_nodegroup=~\"$nodegroup\"}", "legendFormat": "{{node}}"}],
        "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 60}, {"color": "red", "value": 80}]}, "custom": {"thresholdsStyle": {"mode": "line"}}}}
      },
      {
        "title": "Node Memory (%)", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 1}, "datasource": "prometheus",
        "targets": [{"expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes * 100", "legendFormat": "{{instance}}"}],
        "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 60}, {"color": "red", "value": 80}]}, "custom": {"thresholdsStyle": {"mode": "line"}}}}
      },
      {
        "title": "Available Nodes", "type": "stat", "gridPos": {"h": 4, "w": 24, "x": 0, "y": 9}, "datasource": "prometheus",
        "targets": [{"expr": "count(kube_node_labels{label_eks_amazonaws_com_nodegroup=~\"$nodegroup\"}) by (label_eks_amazonaws_com_nodegroup)", "legendFormat": "{{label_eks_amazonaws_com_nodegroup}}"}]
      },
      {"title": "Pod", "type": "row", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 13}, "collapsed": false},
      {
        "title": "Pod CPU", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14}, "datasource": "prometheus",
        "targets": [{"expr": "sum(rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\", container!=\"\"}[5m])) by (pod)", "legendFormat": "{{pod}}"}],
        "fieldConfig": {"defaults": {"unit": "short"}}
      },
      {
        "title": "Pod Memory", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14}, "datasource": "prometheus",
        "targets": [{"expr": "sum(container_memory_working_set_bytes{namespace=~\"$namespace\", container!=\"\"}) by (pod)", "legendFormat": "{{pod}}"}],
        "fieldConfig": {"defaults": {"unit": "bytes"}}
      },
      {
        "title": "Pending Pods", "type": "stat", "gridPos": {"h": 5, "w": 12, "x": 0, "y": 22}, "datasource": "prometheus",
        "targets": [{"expr": "count(kube_pod_status_phase{phase=\"Pending\", namespace=~\"$namespace\"} == 1) or vector(0)", "legendFormat": "Pending"}],
        "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}}
      },
      {
        "title": "Pod Restarts", "type": "stat", "gridPos": {"h": 5, "w": 12, "x": 12, "y": 22}, "datasource": "prometheus",
        "targets": [{"expr": "sum(kube_pod_container_status_restarts_total{namespace=~\"$namespace\"}) by (pod)", "legendFormat": "{{pod}}"}],
        "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 5}]}}}
      },
      {"title": "Application Pod", "type": "row", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 27}, "collapsed": false},
      {
        "title": "App Pod CPU", "type": "timeseries", "gridPos": {"h": 7, "w": 12, "x": 0, "y": 28}, "datasource": "prometheus",
        "targets": [{"expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"wsc2026\", container!=\"\"}[5m])) by (pod)", "legendFormat": "{{pod}}"}],
        "fieldConfig": {"defaults": {"unit": "short"}}
      },
      {
        "title": "App Pod Memory", "type": "timeseries", "gridPos": {"h": 7, "w": 12, "x": 12, "y": 28}, "datasource": "prometheus",
        "targets": [{"expr": "sum(container_memory_working_set_bytes{namespace=\"wsc2026\", container!=\"\"}) by (pod)", "legendFormat": "{{pod}}"}],
        "fieldConfig": {"defaults": {"unit": "bytes"}}
      },
      {
        "title": "App Running", "type": "stat", "gridPos": {"h": 4, "w": 8, "x": 0, "y": 35}, "datasource": "prometheus",
        "targets": [{"expr": "count(kube_pod_status_phase{phase=\"Running\", namespace=\"wsc2026\"})", "legendFormat": "Running"}],
        "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}
      },
      {
        "title": "App Restarts", "type": "stat", "gridPos": {"h": 4, "w": 8, "x": 8, "y": 35}, "datasource": "prometheus",
        "targets": [{"expr": "sum(kube_pod_container_status_restarts_total{namespace=\"wsc2026\"}) by (pod)", "legendFormat": "{{pod}}"}],
        "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 5}]}}}
      },
      {
        "title": "App Pending", "type": "stat", "gridPos": {"h": 4, "w": 8, "x": 16, "y": 35}, "datasource": "prometheus",
        "targets": [{"expr": "count(kube_pod_status_phase{phase=\"Pending\", namespace=\"wsc2026\"} == 1) or vector(0)", "legendFormat": "Pending"}],
        "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}}
      },
      {"title": "Application Traffic", "type": "row", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 39}, "collapsed": false},
      {
        "title": "Request Count", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 40}, "datasource": "cloudwatch",
        "targets": [{"region": "ap-northeast-2", "namespace": "AWS/ApplicationELB", "expression": "SEARCH('{AWS/ApplicationELB,LoadBalancer} MetricName=\"RequestCount\" wsc2026-app-alb', 'Sum', 60)", "id": "q1", "refId": "A", "matchExact": false, "metricQueryType": 0, "metricEditorMode": 1, "statistic": "Sum", "period": "60", "label": "Requests/min"}]
      },
      {
        "title": "Response Time", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 40}, "datasource": "cloudwatch",
        "targets": [{"region": "ap-northeast-2", "namespace": "AWS/ApplicationELB", "expression": "SEARCH('{AWS/ApplicationELB,LoadBalancer} MetricName=\"TargetResponseTime\" wsc2026-app-alb', 'Average', 60)", "id": "q1", "refId": "A", "matchExact": false, "metricQueryType": 0, "metricEditorMode": 1, "statistic": "Average", "period": "60", "label": "Avg Response Time"}],
        "fieldConfig": {"defaults": {"unit": "s"}}
      },
      {
        "title": "Status Codes", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 40}, "datasource": "cloudwatch",
        "targets": [
          {"region": "ap-northeast-2", "namespace": "AWS/ApplicationELB", "expression": "SEARCH('{AWS/ApplicationELB,LoadBalancer} MetricName=\"HTTPCode_Target_2XX_Count\" wsc2026-app-alb', 'Sum', 60)", "id": "q2xx", "refId": "A", "matchExact": false, "metricQueryType": 0, "metricEditorMode": 1, "statistic": "Sum", "period": "60", "label": "2XX"},
          {"region": "ap-northeast-2", "namespace": "AWS/ApplicationELB", "expression": "SEARCH('{AWS/ApplicationELB,LoadBalancer} MetricName=\"HTTPCode_Target_4XX_Count\" wsc2026-app-alb', 'Sum', 60)", "id": "q4xx", "refId": "B", "matchExact": false, "metricQueryType": 0, "metricEditorMode": 1, "statistic": "Sum", "period": "60", "label": "4XX"},
          {"region": "ap-northeast-2", "namespace": "AWS/ApplicationELB", "expression": "SEARCH('{AWS/ApplicationELB,LoadBalancer} MetricName=\"HTTPCode_Target_5XX_Count\" wsc2026-app-alb', 'Sum', 60)", "id": "q5xx", "refId": "C", "matchExact": false, "metricQueryType": 0, "metricEditorMode": 1, "statistic": "Sum", "period": "60", "label": "5XX"},
          {"region": "ap-northeast-2", "namespace": "AWS/ApplicationELB", "expression": "SEARCH('{AWS/ApplicationELB,LoadBalancer} MetricName=\"HTTPCode_ELB_4XX_Count\" wsc2026-app-alb', 'Sum', 60)", "id": "qelb4xx", "refId": "D", "matchExact": false, "metricQueryType": 0, "metricEditorMode": 1, "statistic": "Sum", "period": "60", "label": "ELB 4XX"},
          {"region": "ap-northeast-2", "namespace": "AWS/ApplicationELB", "expression": "SEARCH('{AWS/ApplicationELB,LoadBalancer} MetricName=\"HTTPCode_ELB_5XX_Count\" wsc2026-app-alb', 'Sum', 60)", "id": "qelb5xx", "refId": "E", "matchExact": false, "metricQueryType": 0, "metricEditorMode": 1, "statistic": "Sum", "period": "60", "label": "ELB 5XX"}
        ]
      },
      {
        "title": "Application Logs", "type": "logs", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 48}, "datasource": "cloudwatch",
        "targets": [{
          "queryMode": "Logs",
          "region": "ap-northeast-2",
          "logGroupNames": ["/wsc2026/app/book"],
          "logGroups": [{"arn": "arn:aws:logs:ap-northeast-2:003150130236:log-group:/wsc2026/app/book:*", "name": "/wsc2026/app/book"}],
          "expression": "fields @timestamp, @message | sort @timestamp desc | limit 50",
          "queryLanguage": "CWLI"
        }],
        "options": {"showTime": false, "sortOrder": "Descending", "wrapLogMessage": false, "prettifyLogMessage": false, "dedupStrategy": "none", "enableLogDetails": true}
      },
      {"title": "Alerts", "type": "row", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 56}, "collapsed": false},
      {
        "title": "Active Alerts", "type": "alertlist", "gridPos": {"h": 6, "w": 24, "x": 0, "y": 57}, "datasource": "alertmanager",
        "options": {"alertInstanceLabelFilter": "", "alertName": "", "dashboardAlerts": false, "groupBy": [], "groupMode": "default", "maxItems": 20, "sortOrder": 1, "stateFilter": {"error": true, "firing": true, "noData": false, "normal": false, "pending": true}}
      }
    ],
    "time": {"from": "now-1h", "to": "now"},
    "refresh": "30s"
  }
}
